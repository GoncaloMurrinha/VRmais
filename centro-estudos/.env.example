# Neon (criada pela Vercel em Storage, estas duas variáveis já vêm preenchidas)
# Ligação "Pooled" (o host tem "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Ligação "Direct" (sem "-pooler"), usada pelas migrações do Prisma
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Segredo longo e aleatório (mínimo 32 caracteres): openssl rand -base64 48
AUTH_SECRET=""

# Vercel Blob: Storage -> o teu store -> .env.local (na Vercel é criado automaticamente)
BLOB_READ_WRITE_TOKEN=""

# Só usado por `npm run prisma:seed` para criar o administrador
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
